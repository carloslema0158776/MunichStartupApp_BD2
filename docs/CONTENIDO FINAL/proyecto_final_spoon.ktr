    </partitioning>
    <connection>Conexion_oltp</connection>
    <sql>SELECT
    p.id_persona,
    i.tipo_inversor,
    COALESCE(STRING_AGG(DISTINCT r.nombre_rol, ', '), 'Sin rol') AS nombre_rol,
    p.nombre,
    p.apellido,
    p.direccion,
    p.email,
    p.telefono,
    p.fecha_nacimiento
FROM oltp.persona p
JOIN oltp.inversor i
    ON p.id_persona = i.id_persona
LEFT JOIN oltp.persona_rol pr
    ON p.id_persona = pr.id_persona
LEFT JOIN oltp.roles r
    ON pr.id_rol = r.id_rol
GROUP BY
    p.id_persona,
    i.tipo_inversor,
    p.nombre,
    p.apellido,
    p.direccion,
    p.email,
    p.telefono,
    p.fecha_nacimiento
ORDER BY p.id_persona;</sql>
