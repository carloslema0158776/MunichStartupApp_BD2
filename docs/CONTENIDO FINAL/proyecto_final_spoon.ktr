    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Conexion_oltp</connection>
    <sql>SELECT DISTINCT
    TO_CHAR(fecha_inicio_financiacion, 'YYYYMMDD')::INT AS id_tiempo,
    fecha_inicio_financiacion AS fecha,
    EXTRACT(YEAR FROM fecha_inicio_financiacion)::INT AS anio,
    EXTRACT(MONTH FROM fecha_inicio_financiacion)::INT AS mes,
    EXTRACT(DAY FROM fecha_inicio_financiacion)::INT AS dia,
    EXTRACT(QUARTER FROM fecha_inicio_financiacion)::INT AS trimestre,
    TO_CHAR(fecha_inicio_financiacion, 'Month') AS nombre_mes,
    EXTRACT(DOW FROM fecha_inicio_financiacion)::INT AS dia_semana,
    TO_CHAR(fecha_inicio_financiacion, 'Day') AS nombre_dia,
    CASE 
        WHEN EXTRACT(MONTH FROM fecha_inicio_financiacion) &lt;= 6 THEN 1
        ELSE 2
    END AS semestre,
    CASE
        WHEN EXTRACT(DOW FROM fecha_inicio_financiacion) IN (0, 6) THEN TRUE
        ELSE FALSE
    END AS es_fin_semana
FROM oltp.financiacion;</sql>
