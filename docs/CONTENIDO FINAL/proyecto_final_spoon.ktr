  <step>
    <name>startup input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Conexion_oltp</connection>
    <sql>SELECT
    s.id_startup,
    COALESCE(m.cantidad_mentores, 0) AS cantidad_mentores,
    COALESCE(e.cantidad_emprendedores, 0) AS cantidad_emprendedores,
    COALESCE(o.cantidad_ofertas, 0) AS cantidad_ofertas,
    COALESCE(o.precio_promedio_oferta, 0) AS precio_promedio_oferta,
    o.tipo_oferta,
    m.especialidad,
    e.nivel_educacion,
    s.nombre_startup,
    s.ubicacion_startup,
    s.descripcion,
    s.anio_fundacion,
    s.sitio_web,
    s.estado_startup
FROM oltp.startup s

LEFT JOIN (
    SELECT
        ms.id_startup,
        COUNT(DISTINCT ms.id_persona) AS cantidad_mentores,
        MIN(m.especialidad) AS especialidad
    FROM oltp.mentor_startup ms
    JOIN oltp.mentor m
        ON ms.id_persona = m.id_persona
    GROUP BY ms.id_startup
) m
    ON s.id_startup = m.id_startup

LEFT JOIN (
    SELECT
        se.id_startup,
        COUNT(DISTINCT se.id_persona) AS cantidad_emprendedores,
        MIN(e.nivel_educacion) AS nivel_educacion
    FROM oltp.startup_emprendedor se
    JOIN oltp.emprendedor e
        ON se.id_persona = e.id_persona
    GROUP BY se.id_startup
) e
    ON s.id_startup = e.id_startup

LEFT JOIN (
    SELECT
        o.id_startup,
        COUNT(o.id_oferta) AS cantidad_ofertas,
        AVG(o.precio_oferta) AS precio_promedio_oferta,
        MIN(o.tipo_oferta) AS tipo_oferta
    FROM oltp.oferta o
    GROUP BY o.id_startup
) o
    ON s.id_startup = o.id_startup

ORDER BY s.id_startup;</sql>
